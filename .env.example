# ============================================================
# [PLATFORM] Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- Supabase ----
# Found in: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key  # Server-side only, never expose to browser

# ---- Mapbox ----
# Found in: https://account.mapbox.com → Tokens
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=[PLATFORM]
